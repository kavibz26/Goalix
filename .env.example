# Copy to .env.local for local overrides, and set in the host's env for production.

# REQUIRED in production. The site's public origin — scheme + host, no trailing slash.
# Drives canonical URLs, sitemap.xml, robots.txt, Open Graph tags and JSON-LD.
#
# Server-only (NOT NEXT_PUBLIC_*) — it is only ever rendered server-side and must
# be available at BUILD time (sitemap/robots/metadata are statically generated).
# When unset, the app falls back to http://localhost:3000 (development only).
SITE_URL=
